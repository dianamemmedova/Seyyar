{
  "info": {
    "name": "Seyyar API",
    "description": "All Seyyar backend endpoints. Run Auth → Login first: it saves the access token for the other requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5050/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "requestCode",
      "value": ""
    },
    {
      "key": "photoUrl",
      "value": ""
    },
    {
      "key": "hotelSlug",
      "value": "shirvanshah-boutique-hotel"
    },
    {
      "key": "restaurantSlug",
      "value": "caravan-plov-house"
    },
    {
      "key": "lang",
      "value": "en"
    }
  ],
  "item": [
    {
      "name": "Health",
