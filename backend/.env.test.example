# Settings for automated tests (npm test). Copy to .env.test
NODE_ENV=test

# Separate database: tests DELETE all its data before every test file.
# The name must end with _test.
DATABASE_URL="postgresql://seyyar_user:YOUR_PASSWORD@localhost:5432/seyyar_test"

JWT_SECRET=test-secret-only-for-automated-tests-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=http://localhost:4200
PUBLIC_API_URL=http://localhost:5050
UPLOAD_DIR=uploads-test
APP_WEB_URL=http://localhost:4200

# Emails are never sent in tests (they go to testOutbox in lib/mailer.ts)
SMTP_HOST=
MAIL_FROM="Seyyar <no-reply@seyyar.local>"
ADMIN_NOTIFY_EMAIL=admin@seyyar.test
