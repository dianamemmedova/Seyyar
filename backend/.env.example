# App
NODE_ENV=development
PORT=5050

# Frontend addresses allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:4200,http://localhost:4300

# Database (PostgreSQL)
DATABASE_URL="postgresql://seyyar_user:YOUR_PASSWORD@localhost:5432/seyyar_dev"

# Seed: admin account created by "npm run db:seed"
SEED_ADMIN_EMAIL=admin@seyyar.local
SEED_ADMIN_PASSWORD=CHANGE_ME_min_8_chars

# Auth
# Generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Set to true only when the API runs behind nginx / a load balancer
TRUST_PROXY=false

# Public address of this API (used to build image URLs)
PUBLIC_API_URL=http://localhost:5050
# Folder for uploaded images (relative to the backend folder)
UPLOAD_DIR=uploads

# Website address (used in email links)
APP_WEB_URL=http://localhost:4200

# Email (SMTP). Leave SMTP_HOST empty in development: emails are printed to the terminal
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Seyyar <no-reply@seyyar.local>"
# Receives request emails for places that have no email of their own
ADMIN_NOTIFY_EMAIL=
